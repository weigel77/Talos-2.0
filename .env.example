DELPHI_DEPLOYMENT_ENV=development
DELPHI_RUNTIME_TARGET=hosted
HOSTED_PUBLIC_BASE_URL=https://127.0.0.1:5015
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DELPHI_HOSTED_ALLOWED_EMAILS=

MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_LIVE_PROVIDER=
VIX_HISTORICAL_PROVIDER=
SPX_HISTORICAL_PROVIDER=
APP_TIMEZONE=America/Chicago
APP_HOST=127.0.0.1
APP_PORT=5015
APP_DISPLAY_NAME=Delphi 8.0.7
APP_PAGE_KICKER=Delphi 8.0.7
APP_VERSION_LABEL=Version 8.0.7
SESSION_COOKIE_NAME=delphi5_hosted_session
OAUTH_SESSION_NAMESPACE=delphi5hosted
APP_LOG_PATH=
APOLLO_ENABLED=true
APOLLO_STRUCTURE_SOURCE=es
APOLLO_STRUCTURE_FALLBACK_SOURCE=spx
APOLLO_OPTION_CHAIN_SOURCE=schwab
APOLLO_ROUTINE_LOSS_MODIFIER=0.50
MACRO_PROVIDER=placeholder
FLASK_SECRET_KEY=change-me-for-render

# Schwab OAuth
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:5015/callback
SCHWAB_TRADING_CLIENT_ID=
SCHWAB_TRADING_CLIENT_SECRET=
SCHWAB_TRADING_REDIRECT_URI=https://127.0.0.1:5015/auth/execution/callback
SCHWAB_AUTH_URL=https://api.schwabapi.com/v1/oauth/authorize
SCHWAB_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token
SCHWAB_BASE_URL=https://api.schwabapi.com/marketdata/v1
SCHWAB_TOKEN_PATH=instance/schwab_market_data_token.json
SCHWAB_SHARED_MARKET_TOKEN_PATH=instance/schwab_market_data_token.json
SCHWAB_ES_PRIMARY_SYMBOL=/ES
SCHWAB_ES_FALLBACK_SYMBOL=ES
SCHWAB_SPX_OPTION_CHAIN_SYMBOL=SPX
SCHWAB_HISTORY_PERIOD_TYPE=year
SCHWAB_HISTORY_PERIOD=20
SCHWAB_HISTORY_FREQUENCY_TYPE=daily
SCHWAB_HISTORY_FREQUENCY=1
SCHWAB_HISTORY_NEED_EXTENDED_HOURS=false
KAIROS_REPLAY_STORAGE_DIR=

